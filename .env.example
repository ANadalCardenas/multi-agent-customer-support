# Copy this file to .env and fill in your own values.
# .env is git-ignored and must never be committed.

# Required: your OpenAI API key.
OPENAI_API_KEY=your_key_here

# Optional: only needed if you're using a Vocareum-issued key,
# which requires pointing the OpenAI client at their proxy.
OPENAI_BASE_URL=your_vocareum_base_url
